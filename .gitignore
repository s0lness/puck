node_modules/

# Build outputs: regenerate with `bun run example:build` / `bun run build`
wasm/dist/
/dist/

# tools/zigSpawn.ts's own repo-local zig global cache (isolated from
# ~/AppData/Local/zig or equivalent so no other project or stray process
# can poison it, and so a silent-failure wipe never touches anything but
# this repo's own copy - see that file's header comment).
/.zig-cache/
/.zig-global-cache/

# The device firmware's CMake build tree (25MB of objects and a copy of half
# the Pico SDK's object files). Regenerate with the two cmake commands in
# packs/rp2350-touch-amoled-18/README.md; the .uf2 it produces is attached to a GitHub release,
# never committed.
packs/rp2350-touch-amoled-18/firmware/build/

# The ESP-IDF build tree, its generated sdkconfig, and the components the
# IDF component manager downloads into the project. Regenerate all three
# with the `idf.py` invocation in packs/esp32-s3-touch-amoled-18/README.md;
# sdkconfig.defaults (which IS committed) is the only configuration input.
packs/esp32-s3-touch-amoled-18/firmware/build/
packs/esp32-s3-touch-amoled-18/firmware/sdkconfig
packs/esp32-s3-touch-amoled-18/firmware/sdkconfig.old
packs/esp32-s3-touch-amoled-18/firmware/managed_components/

# Same reasoning, for the single-app native build dirs tools/build-native.ts
# creates out of tree (one per --app, e.g. firmware/build-app/fluid/): the
# .uf2 it produces is copied out to site/dist/flash/ or a GitHub release,
# never committed from here either.
packs/rp2350-touch-amoled-18/firmware/build-app/
packs/esp32-s3-touch-amoled-18/firmware/build-app/

# Hostile-firmware regression suite build output: regenerate with
# `bun run test:hostile` (or `bun run test/hostile/build.ts` on its own)
test/hostile/dist/

# Regression-check test fixture build output: regenerate with
# `bun run test:regression` (or `bun run test/regression/build.ts` on its own)
test/regression/dist/

# WASI-lite fixture build output: regenerate with `bun run test:wasi`
# (or `bun run test/wasi/build.ts` on its own)
test/wasi/dist/

# The host harness's own fixture wasm: regenerate with `bun run test:host`
test/host/dist/

# The external-port fixture's own build output: its bundle's build command
# writes it into a temporary checkout, but a developer running that command
# by hand in the fixture directory would leave a copy here
test/fixtures/external-app/dist/

# Runtime-written, transient (see docs/agent-loop.md)
/freezes/
/traces/

# The hardware-free regression check's own state (src/regression.ts):
# baselines/ is what you saved, regressions/ is the last check's result.
# Both transient by the same reasoning as freezes/ and traces/ above.
/baselines/
/regressions/

# Differential harness output (PNGs from `bun run harness/diff.ts --out`)
harness/out/

*.log
.DS_Store
Thumbs.db

# Pack-local native build outputs (the .uf2 goes on a GitHub release,
# never in git - see the comment above about firmware/build/)
packs/*/dist/

# Session-local agent state and worktrees, never committed
/.claude/

# This machine's own toolchain paths for an external bundle's build command
# (tools/externalBuild.ts's "host toolchain hints"); toolchains.example.json
# is the committed, path-free shape.
/toolchains.local.json
